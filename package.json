{
  "name": "ryutama-charsheet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "lint": "oxlint apps/web/src functions/src packages/*/src tests",
    "format": "oxfmt",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter functions build && concurrently -k -n functions,emulators,web \"pnpm --filter functions dev\" \"firebase emulators:start --only firestore,functions\" \"pnpm --filter web dev\"",
    "emulators": "pnpm --filter functions build && pnpm --filter web build:emulator && firebase emulators:start",
    "firebase:deploy": "firebase deploy",
    "test:emulator": "firebase emulators:exec --only firestore \"vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
