{
  "name": "functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions && node scripts/write-lib-package.mjs",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --watch=forever",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@ryutama/character": "workspace:*",
    "@types/node": "^24.19.2",
    "effect": "4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
